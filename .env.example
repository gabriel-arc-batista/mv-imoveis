# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente para scripts de servidor/admin (NUNCA expor no client, nunca commitar)
SUPABASE_SERVICE_ROLE_KEY=

# Número de WhatsApp da MV Imóveis, formato internacional sem símbolos (ex: 5581999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# XML Imovelweb — somente servidor. Habilitar depois de validar a carga e as regras do portal.
IMOVELWEB_XML_ENABLED=false
# Gerar com: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
IMOVELWEB_FEED_TOKEN=
# Código reconhecido pelo portal; confirmar com o atendimento antes da ativação.
IMOVELWEB_CODIGO_IMOBILIARIA=
IMOVELWEB_ESTADO=Pernambuco
IMOVELWEB_EMAIL_CONTATO=
IMOVELWEB_NOME_CONTATO=
IMOVELWEB_TELEFONE_CONTATO=
