# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente para scripts de servidor/admin (NUNCA expor no client, nunca commitar)
SUPABASE_SERVICE_ROLE_KEY=

# Número de WhatsApp da MV Imóveis, formato internacional sem símbolos (ex: 5581999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Imovelweb (README, seção 8). Tudo só no servidor: nunca usar NEXT_PUBLIC_.
# Código da imobiliária na integração (o mesmo usado no vínculo da conta).
IMOVELWEB_CODIGO_IMOBILIARIA=

# Credenciais da API enviadas pelo Imovelweb.
IMOVELWEB_CLIENT_ID=
IMOVELWEB_CLIENT_SECRET=
# Nome do integrador informado pelo Imovelweb (ativa o botão de vínculo no painel)
IMOVELWEB_INTEGRADOR=
# Opcional: sandbox = https://api-br-sandbox-open.navent.com
IMOVELWEB_API_URL=
# Usada pela sincronização (gravar imóveis e fotos importados)
# SUPABASE_SERVICE_ROLE_KEY (acima) é obrigatória no modo API.
# Segredo do Vercel Cron (sincronização diária). Valor longo e aleatório.
CRON_SECRET=

# Estado usado na localização de todas as cidades (padrão: Pernambuco)
IMOVELWEB_ESTADO=
# Opcionais: substituem os dados de contato do painel do Imovelweb
IMOVELWEB_EMAIL_CONTATO=
IMOVELWEB_NOME_CONTATO=
IMOVELWEB_TELEFONE_CONTATO=
